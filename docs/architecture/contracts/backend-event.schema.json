{
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "backend_instance_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
    },
    "runtime_generation": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$(?![\\s\\S])"
    },
    "conversation_ref": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "conversation_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
            },
            "backend_instance_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
            },
            "native_conversation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            }
          },
          "required": [
            "conversation_id",
            "backend_instance_id",
            "native_conversation_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "native_input_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "native_run_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "protocol_version",
    "backend_instance_id",
    "stream_id",
    "sequence",
    "event_id",
    "runtime_generation",
    "occurred_at",
    "type",
    "conversation_ref",
    "request_id",
    "native_input_id",
    "native_run_id",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:im-assistant:design:backend-event:1",
  "title": "后端公开持久事件信封",
  "description": "source identity=(backend_instance_id,stream_id,event_id); sequence orders this stream; runtime_generation is NOT event dedupe identity.",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "pattern": "^run\\."
          }
        }
      },
      "then": {
        "properties": {
          "native_run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "conversation_ref": {
            "type": "object",
            "properties": {
              "conversation_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
              },
              "backend_instance_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
              },
              "native_conversation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              }
            },
            "required": [
              "conversation_id",
              "backend_instance_id",
              "native_conversation_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "input.accepted",
              "input.applied"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
          },
          "native_input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
          },
          "conversation_ref": {
            "type": "object",
            "properties": {
              "conversation_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
              },
              "backend_instance_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
              },
              "native_conversation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              }
            },
            "required": [
              "conversation_id",
              "backend_instance_id",
              "native_conversation_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "message.upsert",
              "message.committed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "conversation_ref": {
            "type": "object",
            "properties": {
              "conversation_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
              },
              "backend_instance_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
              },
              "native_conversation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
              }
            },
            "required": [
              "conversation_id",
              "backend_instance_id",
              "native_conversation_id"
            ],
            "additionalProperties": false
          },
          "payload": {
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "$ref": "#/$defs/message"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "resource_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        "backend_instance_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
        },
        "conversation_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
        },
        "mime_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "backend_instance_id",
        "conversation_id",
        "mime_type",
        "size_bytes",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "tool",
            "system"
          ]
        },
        "phase": {
          "enum": [
            "pending",
            "commentary",
            "final"
          ]
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_input_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_run_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 262144
        },
        "resource_ref": {
          "$ref": "#/$defs/resource_ref"
        },
        "attachments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/resource_ref"
          }
        }
      },
      "required": [
        "id",
        "revision",
        "order",
        "role",
        "phase",
        "request_id",
        "native_input_id",
        "native_run_id"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "text"
          ],
          "not": {
            "required": [
              "resource_ref"
            ]
          }
        },
        {
          "required": [
            "resource_ref"
          ],
          "not": {
            "required": [
              "text"
            ]
          }
        }
      ]
    },
    "conversation_ref": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
        },
        "backend_instance_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
        },
        "native_conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        }
      },
      "required": [
        "conversation_id",
        "backend_instance_id",
        "native_conversation_id"
      ],
      "additionalProperties": false
    },
    "resource_read": {
      "type": "object",
      "properties": {
        "principal_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
        },
        "conversation_ref": {
          "$ref": "#/$defs/conversation_ref"
        },
        "resource_ref": {
          "$ref": "#/$defs/resource_ref"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        }
      },
      "required": [
        "principal_id",
        "conversation_ref",
        "resource_ref",
        "offset",
        "limit"
      ],
      "additionalProperties": false
    },
    "resource_chunk": {
      "type": "object",
      "properties": {
        "resource_ref": {
          "$ref": "#/$defs/resource_ref"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "data_base64": {
          "type": "string",
          "maxLength": 349528
        },
        "eof": {
          "type": "boolean"
        }
      },
      "required": [
        "resource_ref",
        "offset",
        "data_base64",
        "eof"
      ],
      "additionalProperties": false
    }
  }
}
