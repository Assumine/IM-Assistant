{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$(?![\\s\\S])"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "kind": {
      "enum": [
        "conversation_backend",
        "module"
      ]
    },
    "host_protocol": {
      "const": 1
    },
    "runtime": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "managed_process",
            "external_service"
          ]
        },
        "transport": {
          "enum": [
            "stdio_jsonrpc",
            "loopback_http"
          ]
        },
        "start": {
          "enum": [
            "on_demand",
            "with_host"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "endpoint": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{2,5}/[a-zA-Z0-9_/-]*$(?![\\s\\S])"
        }
      },
      "required": [
        "mode",
        "transport",
        "start"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "managed_process"
              }
            }
          },
          "then": {
            "required": [
              "command"
            ],
            "properties": {
              "transport": {
                "const": "stdio_jsonrpc"
              }
            },
            "not": {
              "required": [
                "endpoint"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "external_service"
              }
            }
          },
          "then": {
            "required": [
              "endpoint"
            ],
            "properties": {
              "transport": {
                "const": "loopback_http"
              }
            },
            "not": {
              "required": [
                "command"
              ]
            }
          }
        }
      ]
    },
    "backend_descriptor": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+\\.json$(?![\\s\\S])"
    },
    "config_schema": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+\\.json$(?![\\s\\S])"
    },
    "data_version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,159}$(?![\\s\\S])"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "required": {
            "type": "boolean"
          },
          "protocol": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "capability",
          "required",
          "protocol"
        ],
        "additionalProperties": false
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "contributions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*$(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "annotations": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "display_name",
    "kind",
    "host_protocol",
    "runtime",
    "data_version",
    "dependencies",
    "permissions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:im-assistant:design:module-manifest:1",
  "title": "整套后端或通用模块的包清单",
  "description": "设计规范。发现阶段只读取本清单；contributions 未知命名空间不执行。",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "conversation_backend"
          }
        }
      },
      "then": {
        "required": [
          "backend_descriptor"
        ]
      }
    }
  ]
}
